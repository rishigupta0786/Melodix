{
  "name": "vibe-coding-music-player",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#modules/*": "./lib/jiosaavn-api/src/modules/*",
    "#common/*": "./lib/jiosaavn-api/src/common/*"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cap:run:android:dev": "npx cap run android -l --external",
    "mobile:build": "npm run build && npx cap sync android",
    "mobile:apk": "cd android && ./gradlew assembleDebug",
    "mobile:apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "hono": "^4.13.7",
    "next": "16.3.3",
    "node-forge": "^1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4"
  }
}
